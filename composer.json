{
    "name": "alishernportfolio/laravel-antibot",
    "description": "Application-agnostic anti-bot protection for Laravel: risk-based scoring, sliding-window rate limiting, proof-of-work challenges, temporary blocking, and network-verified search engine crawler bypass (Googlebot, Bingbot).",
    "keywords": [
        "laravel",
        "antibot",
        "anti-bot",
        "bot-protection",
        "rate-limiting",
        "security",
        "proof-of-work",
        "googlebot",
        "bingbot",
        "scraping"
    ],
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "AlisherNPortfolio",
            "homepage": "https://github.com/AlisherNPortfolio"
        }
    ],
    "require": {
        "php": "^8.2",
        "ext-json": "*",
        "illuminate/contracts": "^11.0|^12.0|^13.0",
        "illuminate/http": "^11.0|^12.0|^13.0",
        "illuminate/routing": "^11.0|^12.0|^13.0",
        "illuminate/support": "^11.0|^12.0|^13.0"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0|^10.0|^11.0",
        "pestphp/pest": "^2.34|^3.0",
        "pestphp/pest-plugin-laravel": "^2.4|^3.0",
        "phpstan/phpstan": "^1.11|^2.0",
        "predis/predis": "^2.2"
    },
    "autoload": {
        "psr-4": {
            "AlisherNPortfolio\\LaravelAntiBot\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "AlisherNPortfolio\\LaravelAntiBot\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "AlisherNPortfolio\\LaravelAntiBot\\AntiBotServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "scripts": {
        "test": "vendor/bin/pest",
        "test-coverage": "vendor/bin/pest --coverage",
        "analyse": "vendor/bin/phpstan analyse"
    }
}
